generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================
// User Management
// ===========================================

model User {
  id          String   @id @default(cuid())
  firebaseUid String   @unique @map("firebase_uid")
  email       String   @unique

  displayName String?  @map("display_name")
  timezone    String   @default("America/New_York")

  deletedAt   DateTime? @map("deleted_at")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  bankAccount BankAccount?
  alarms      Alarm[]
  penalties   Penalty[]

  @@map("users")
}

// ===========================================
// Bank Account (Plaid Integration)
// ===========================================

model BankAccount {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")

  plaidAccessToken String @map("plaid_access_token")
  plaidItemId      String @map("plaid_item_id")
  plaidAccountId   String @map("plaid_account_id")

  institutionName String @map("institution_name")
  accountName     String @map("account_name")
  accountMask     String @map("account_mask")

  stripeCustomerId    String? @map("stripe_customer_id")
  stripeBankAccountId String? @map("stripe_bank_account_id")

  mandateAcceptedAt DateTime? @map("mandate_accepted_at")
  mandateIpAddress  String?   @map("mandate_ip_address")
  mandateUserAgent  String?   @map("mandate_user_agent")

  status            BankAccountStatus @default(ACTIVE)
  failureCount      Int               @default(0) @map("failure_count")
  lastFailureReason String?           @map("last_failure_reason")

  linkedAt  DateTime @default(now()) @map("linked_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("bank_accounts")
}

enum BankAccountStatus {
  ACTIVE
  NEEDS_RELINK
  DISABLED
}

// ===========================================
// Alarms
// ===========================================

model Alarm {
  id     String @id @default(cuid())
  userId String @map("user_id")

  hour   Int
  minute Int

  isEnabled  Boolean @default(true) @map("is_enabled")
  label      String?
  repeatDays Int[]   @default([]) @map("repeat_days")
  skipPenalty Boolean @default(false) @map("skip_penalty")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  penalties Penalty[]

  @@map("alarms")
}

// ===========================================
// Penalties (Snooze Records)
// ===========================================

model Penalty {
  id     String @id @default(cuid())
  userId String @map("user_id")

  alarmId       String? @map("alarm_id")
  occurrenceId  String  @map("occurrence_id")

  amount       Int
  snoozeNumber Int           @map("snooze_number")
  status       PenaltyStatus @default(PENDING)

  stripePaymentIntentId String? @map("stripe_payment_intent_id")
  failureReason         String? @map("failure_reason")

  triggeredAt DateTime  @default(now()) @map("triggered_at")
  processedAt DateTime? @map("processed_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  alarm Alarm? @relation(fields: [alarmId], references: [id], onDelete: SetNull)

  @@unique([userId, occurrenceId, snoozeNumber], name: "unique_snooze_per_occurrence")
  @@index([userId, triggeredAt])
  @@index([status])
  @@map("penalties")
}

enum PenaltyStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REQUIRES_ACTION
}

// ===========================================
// Audit Log
// ===========================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")

  action    String
  details   Json?
  ipAddress String?  @map("ip_address")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
