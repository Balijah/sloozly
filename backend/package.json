{
  "name": "sloozly-backend",
  "version": "0.1.0",
  "description": "Backend API for Sloozly - the accountability alarm app",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "firebase-admin": "^12.0.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "plaid": "^23.0.0",
    "stripe": "^14.12.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^8.56.0",
    "prettier": "^3.2.0",
    "prisma": "^5.8.0",
    "supertest": "^7.3.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "alarm",
    "accountability",
    "fintech",
    "plaid",
    "stripe"
  ],
  "author": "Burhan Khan",
  "license": "UNLICENSED",
  "private": true
}
