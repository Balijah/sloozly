# ===========================================
# Sloozly Backend — Environment Configuration
# ===========================================
# Copy to .env and fill in your values.
# NEVER commit .env to version control.
# All Stripe/Plaid keys below are SANDBOX / TEST MODE.
# ===========================================

# Server
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/sloozly

# Firebase Admin SDK
# Get from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Plaid (sandbox only for beta)
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
PLAID_ENV=sandbox

# Stripe (test mode only for beta)
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Penalty Configuration
# Flat amount per snooze, in cents (default $5.00)
PENALTY_AMOUNT_CENTS=500
# Maximum total penalties per calendar day, in cents (default $25.00)
PENALTY_DAILY_CAP_CENTS=2500

# Logging
LOG_LEVEL=debug
